<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaSound MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build novasound.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.scraft` sessions owned by
  NovaSound, and NovaSound offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="NovaSound"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="EE53D3E5-D0AE-40F9-808D-9417FDEBF61A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NovaSound digital audio workstation" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NovaSound is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NovasoundIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NovasoundIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://workflowind.agcunae.com/apps/novasound" />
    <Property Id="ARPURLUPDATEINFO" Value="https://workflowind.agcunae.com/apps/novasound" />
    <Property Id="ARPHELPLINK" Value="https://workflowind.agcunae.com/inbox" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NovaSound" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="NovaSound" Level="1">
      <ComponentGroupRef Id="NovasoundFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NovasoundFiles" Directory="INSTALLFOLDER">
      <Component Id="NovasoundApp" Guid="091136D7-205E-41A8-9D27-5E231F7CBBD4">
        <File Id="NovasoundExe" Source="$(var.BinDir)\novasound.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NovaSound"
              Description="NovaSound digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NovasoundIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: NovaSound's own session format; NovaSound is its default app. -->
        <ProgId Id="NovaSound.Session" Description="NovaSound Session" Icon="NovasoundExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-novasound-session">
            <Verb Id="open" Command="Open" TargetFile="NovasoundExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="NovaSound.Audio" Description="Audio File" Icon="NovasoundExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\NovaSound.Audio\shell\open\command" Value="&quot;[#NovasoundExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="NovaSound.Midi" Description="MIDI File" Icon="NovasoundExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\NovaSound.Midi\shell\open\command" Value="&quot;[#NovasoundExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="NovaSound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="NovaSound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="NovaSound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="NovaSound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="NovaSound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="NovaSound.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="NovaSound.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "novasound"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe" Name="FriendlyAppName" Value="NovaSound" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\shell\open\command" Value="&quot;[#NovasoundExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novasound.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novasound.exe" Value="[#NovasoundExe]" Type="string" />
      </Component>

      <Component Id="NovasoundCli" Guid="4552049A-C2F0-4AB0-BAE6-A62C3348F4B4">
        <File Id="NovasoundCliExe" Source="$(var.BinDir)\novasound-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
